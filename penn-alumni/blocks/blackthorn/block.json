{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "penn/blackthorn",
	"title": "Blackthorn Events Embed",
	"category": "penn",
	"description": "Embeds a Blackthorn calendar, event group, event page or registration form.",
	"icon": "tickets-alt",
	"textdomain": "penn-alumni",
	"attributes": {
		"path": {
			"type": "string",
			"default": ""
		},
		"mode": {
			"type": "string",
			"default": "advanced"
		},
		"height": {
			"type": "number",
			"default": 900
		},
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"className": true,
		"html": false
	},
	"editorScript": "penn-blocks-editor",
	"render": "file:./render.php"
}