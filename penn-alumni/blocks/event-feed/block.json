{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "penn/event-feed",
	"title": "Event Feed",
	"category": "penn",
	"description": "Upcoming events (paEventFeed). Today: sample data. Production: the Blackthorn / Salesforce connection fills it automatically.",
	"icon": "calendar-alt",
	"textdomain": "penn-alumni",
	"attributes": {
		"layout": {
			"type": "string",
			"default": "list"
		},
		"count": {
			"type": "number",
			"default": 5
		},
		"filter": {
			"type": "string",
			"default": ""
		},
		"columns": {
			"type": "number",
			"default": 3
		}
	},
	"supports": {
		"className": true,
		"html": false
	},
	"editorScript": "penn-blocks-editor",
	"render": "file:./render.php"
}